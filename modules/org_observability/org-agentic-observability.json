            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 36,
        "height": 18,
        "width": 24,
        "widget": {
          "title": "Input tokens by project (15 min)",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/token_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" metric.label.type=\"input\"",
