{
  "displayName": "Agent Observability",
  "description": "AI token usage: project-level (native metrics) and per-agent (llm_usage log metrics). Flat mosaic layout matching Agent Gateway Observability.",
  "labels": {},
  "dashboardFilters": [
    {
      "filterType": "VALUE_ONLY",
      "labelKey": "",
      "templateVariable": "agent_id",
      "timeSeriesQuery": {
        "opsAnalyticsQuery": {
          "savedQueryId": "",
          "sql": "SELECT DISTINCT JSON_VALUE(json_payload.agent_id) AS agent_id FROM `agentic-ai-lens-placeholder.global._Default._AllLogs` WHERE resource.type = 'aiplatform.googleapis.com/ReasoningEngine' AND JSON_VALUE(json_payload.event) = 'llm_usage' AND JSON_VALUE(json_payload.agent_id) IS NOT NULL ORDER BY agent_id"
        },
        "outputFullDuration": false,
        "unitOverride": ""
      },
      "valueType": "STRING"
    },
    {
      "filterType": "VALUE_ONLY",
      "labelKey": "",
      "templateVariable": "department",
      "timeSeriesQuery": {
        "opsAnalyticsQuery": {
          "savedQueryId": "",
          "sql": "SELECT DISTINCT JSON_VALUE(json_payload.department) AS department FROM `agentic-ai-lens-placeholder.global._Default._AllLogs` WHERE resource.type = 'aiplatform.googleapis.com/ReasoningEngine' AND JSON_VALUE(json_payload.event) = 'llm_usage' AND JSON_VALUE(json_payload.department) IS NOT NULL ORDER BY department"
        },
        "outputFullDuration": false,
        "unitOverride": ""
      },
      "valueType": "STRING"
    },
    {
      "filterType": "VALUE_ONLY",
      "labelKey": "",
      "templateVariable": "agent_role",
      "timeSeriesQuery": {
        "opsAnalyticsQuery": {
          "savedQueryId": "",
          "sql": "SELECT DISTINCT JSON_VALUE(json_payload.agent_role) AS agent_role FROM `agentic-ai-lens-placeholder.global._Default._AllLogs` WHERE resource.type = 'aiplatform.googleapis.com/ReasoningEngine' AND JSON_VALUE(json_payload.event) = 'llm_usage' AND JSON_VALUE(json_payload.agent_role) IS NOT NULL ORDER BY agent_role"
        },
        "outputFullDuration": false,
        "unitOverride": ""
      },
      "valueType": "STRING"
    }
  ],
  "mosaicLayout": {
    "columns": 48,
    "tiles": [
      {
        "xPos": 0,
        "yPos": 0,
        "height": 12,
        "width": 48,
        "widget": {
          "title": "Open token alert incidents (AL8)",
          "incidentList": {
            "monitoredResources": [],
            "policyNames": __ALERT_POLICY_NAMES__
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 12,
        "height": 4,
        "width": 48,
        "widget": {
          "title": "Alert policies & runbook (AL9)",
          "text": {
            "content": "**Token alerts:** AL1 baseline spike · AL2 runaway loop · AL3 project surge · AL4 absolute ceiling · AL5 error + tokens · AL6 zero traffic (optional)\n\n- [Alert policies](https://console.cloud.google.com/monitoring/alerting/policies?project=agentic-ai-lens-placeholder)\n- [Logs — llm_usage](https://console.cloud.google.com/logs/query;query=resource.type%3D%22aiplatform.googleapis.com%2FReasoningEngine%22%0AjsonPayload.event%3D%22llm_usage%22;duration=PT1H?project=agentic-ai-lens-placeholder)\n- [Instrumentation spec](https://github.com/) — see `docs/agent-instrumentation-spec.md` in agw-observability\n\nFilter **@agent_id**, **@department**, or **@agent_role** below to focus Agents widgets and log panels.",
            "format": "MARKDOWN"
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 16,
        "height": 8,
        "width": 16,
        "widget": {
          "title": "Total tokens — 7 days (P4)",
          "scorecard": {
            "timeSeriesQuery": {
              "timeSeriesFilter": {
                "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/token_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\"",
                "aggregation": {
                  "alignmentPeriod": "604800s",
                  "perSeriesAligner": "ALIGN_DELTA",
                  "crossSeriesReducer": "REDUCE_SUM",
                  "groupByFields": []
                }
              },
              "outputFullDuration": true
            },
            "sparkChartView": {
              "sparkChartType": "SPARK_LINE"
            }
          }
        }
      },
      {
        "xPos": 16,
        "yPos": 16,
        "height": 8,
        "width": 16,
        "widget": {
          "title": "Input tokens — 7 days (P4)",
