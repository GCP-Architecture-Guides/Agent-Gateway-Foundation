        "widget": {
          "title": "Agents — per-agent usage",
          "text": {
            "content": "**Per-agent LLM usage** from structured `llm_usage` logs on Reasoning Engines. Use **@agent_id** (A5) to filter Agents widgets.\n\nCharts populate after **Reasoning Engine redeploy** (see `docs/agent-instrumentation-spec.md`). Log-based metrics do not backfill.\n\nMetrics: `logging.googleapis.com/user/lens_llm_*` · 15-minute buckets",
            "format": "MARKDOWN"
          }
        }
