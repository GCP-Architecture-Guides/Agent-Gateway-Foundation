            "chartType": "DONUT",
            "dataSets": [
              {
                "minAlignmentPeriod": "86400s",
                "timeSeriesQuery": {
                  "outputFullDuration": true,
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/token_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\"",
                    "aggregation": {
