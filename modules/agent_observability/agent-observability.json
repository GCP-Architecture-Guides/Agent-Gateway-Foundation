      {
        "xPos": 0,
        "yPos": 112,
        "height": 18,
        "width": 48,
        "widget": {
          "title": "Top agents — 24h tokens & calls (A2)",
          "timeSeriesTable": {
            "columnSettings": [
              {
                "column": "agent_id",
                "displayName": "Agent",
                "visible": true
              },
              {
                "column": "value",
                "displayName": "Total tokens (24h)",
                "visible": true
              },
              {
                "column": "value-1",
                "displayName": "LLM calls (24h)",
                "visible": true
              }
            ],
            "dataSets": [
              {
                "minAlignmentPeriod": "86400s",
                "tableTemplate": "",
                "timeSeriesQuery": {
                  "outputFullDuration": true,
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/lens_llm_total_tokens\" resource.type=\"aiplatform.googleapis.com/ReasoningEngine\" metric.label.agent_id=monitoring.regex.full_match(${agent_id})",
                    "aggregation": {
                      "alignmentPeriod": "86400s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.agent_id"
                      ]
                    },
                    "pickTimeSeriesFilter": {
                      "direction": "TOP",
                      "numTimeSeries": 25,
                      "rankingMethod": "METHOD_MEAN"
                    }
                  }
                }
              },
              {
                "minAlignmentPeriod": "86400s",
                "tableTemplate": "",
                "timeSeriesQuery": {
                  "outputFullDuration": true,
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/lens_llm_call_count\" resource.type=\"aiplatform.googleapis.com/ReasoningEngine\" metric.label.agent_id=monitoring.regex.full_match(${agent_id})",
                    "aggregation": {
                      "alignmentPeriod": "86400s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.agent_id"
                      ]
                    },
