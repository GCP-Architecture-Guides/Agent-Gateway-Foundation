      {
        "xPos": 24,
        "yPos": 24,
        "height": 12,
        "width": 24,
        "widget": {
          "title": "Project — related views",
          "text": {
            "content": "**Project-level Gemini tokens** (all Vertex usage in this project, not Lens-only).\n\n- [Vertex AI — Model observability](https://console.cloud.google.com/vertex-ai/dashboard?project=agentic-ai-lens-placeholder)\n- [Cloud Billing — Reports](https://console.cloud.google.com/billing/reports?project=agentic-ai-lens-placeholder)\n- [Metrics Explorer — token_count](https://console.cloud.google.com/monitoring/metrics-explorer?project=agentic-ai-lens-placeholder)\n\nNative metric: `aiplatform.googleapis.com/publisher/online_serving/token_count` · 15-minute buckets",
            "format": "MARKDOWN"
          }
