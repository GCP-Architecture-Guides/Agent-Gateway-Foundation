# =============================================================================
# terraform.tfvars.example
#
# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored and should NEVER be committed.
#
#   cp terraform.tfvars.example terraform.tfvars
#   # then edit terraform.tfvars with your project details
# =============================================================================

# =========================================================================
# REQUIRED: Core Infrastructure
# =========================================================================
# Your GCP project ID (not project number)
project_id = "YOUR_PROJECT_ID"

# GCP region for all resources (Agent Gateway, Model Armor, VPC, etc.)
region   = "us-east1"
location = "us-east1"

# Short prefix used to name all resources (gateways, templates, policies).
# Use lowercase letters, digits, and hyphens only. Max ~15 chars recommended.
# Example: "acme-corp", "my-org", "team-alpha"
prefix = "your-org-prefix"

# Your GCP Organization ID (numeric, e.g. "123456789012").
# Find it with: gcloud organizations list
organization_id = "YOUR_ORG_ID"

# =========================================================================
# AGENT DEPLOYMENT METADATA
# =========================================================================
# Display name of the Reasoning Engine agent. Used in guardrail tests and
# Vertex AI Console.
# IMPORTANT: MUST be a valid Python identifier — underscores only, NO hyphens.
#   chat_agent_v1 ✅   chat-agent-v1 ❌ (deploy script validates and fails fast)
agent_name        = "chat_agent_v1"
agent_description = "A foundational chat agent demonstrating Agent Gateway security integrations."

# Org telemetry labels — required by the OTEL org policy constraint.
agent_department = "engineering"
agent_team       = "sec_ops"
# agent_role     = "customer_support"   # optional, has a default

# =========================================================================
# EGRESS GATEWAY CONFIGURATION
# =========================================================================
# Hosts the agent is allowed to call via PSC egress routing.
# Hosts NOT in the combined list -> gateway drops connection (deny-by-default).
#
# FOUNDATION DEFAULTS (automatically registered -- do NOT add these here):
#   The following 12 hosts are always registered by 07_agent_registry.tf:
#     aiplatform.googleapis.com, <region>-aiplatform.googleapis.com,
#     iamcredentials.googleapis.com, oauth2.googleapis.com,
#     cloudresourcemanager.googleapis.com, logging.googleapis.com,
#     cloudtrace.googleapis.com, monitoring.googleapis.com,
#     storage.googleapis.com, secretmanager.googleapis.com,
#     agentregistry.googleapis.com, telemetry.googleapis.com
#
# PROJECT-SPECIFIC HOSTS (add only what your agent calls beyond the defaults):
allowed_egress_hosts = [
  # ---- Reference / documentation APIs (food-court demo) ----
  "github.com",
  "api.github.com",
  "raw.githubusercontent.com",
  "www.google.com",

  # ---- GCP APIs beyond foundation defaults (add as needed) ----
  "cloudasset.googleapis.com",
  "discoveryengine.googleapis.com",
  "cloudresourcemanager.mtls.googleapis.com",
  "www.googleapis.com",

  # ---- Project-specific tool APIs (customize per project) ----
  # "api.example.com",
  # "hooks.slack.com",
]
# =========================================================================
# OBSERVABILITY ALERTS (OPTIONAL)
# =========================================================================
# slack_auth_token    = "xoxb-YOUR-SLACK-BOT-TOKEN"
# slack_channel_name  = "#agent-alerts"
# alert_email_address = "alerts@your-domain.com"
# google_chat_space   = "spaces/YOUR_SPACE_ID"
